#!/usr/bin/env bash
# fortivpn — openfortivpn driver for the Omarchy shell plugin omafortivpn.
#
# Profiles are plain openfortivpn config files owned by you, one per gateway,
# in ~/.config/fortivpn/profiles. Only the connect itself needs root; creating,
# editing, and deleting a profile never do.
#
# Run `fortivpn help` for the command list.

set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fortivpn"
PROFILE_DIR="$CONFIG_DIR/profiles"
DEFAULT_FILE="$CONFIG_DIR/default"
# Everything root reads or writes for the tunnel lives in directories only
# root can write to, so nothing running as you can swap a file out from under
# the privileged side between the sudo prompt and the moment it is used.
# The transient config holds secrets and is root's alone; the log directory is
# readable by your group so the window, the panel and `fortivpn log` can show it.
RUN_DIR=/run/fortivpn
LOG_DIR="/var/log/fortivpn/$(id -u)"
OPENFORTIVPN=/usr/bin/openfortivpn
IFNAME=fortivpn0
APP=FortiVPN
UNIT=fortivpn-tunnel

# The config handed to the running tunnel, holding the secrets typed at
# connect time. Set by cmd_run, and removed again by run_cleanup on every way
# out of it.
RUN_CONF=""

# Every state read and every privileged signal targets openfortivpn processes
# running *this* plugin's tunnel, identified by the interface name they were
# started with. Anchoring the match at the start of the command line keeps out
# the `sudo openfortivpn …` parent and anything else that merely mentions the
# flag, and matching on a pattern rather than on a PID means the target is
# resolved at signal time, inside the privileged call.
#
# Only processes whose real UID is root (-U 0) count. The tunnel is started by
# systemd as root, so a process of yours that merely fakes that command line
# is neither signalled with root's authority nor taken for a live tunnel.
VPN_MATCH='^(/[^ ]*/)?openfortivpn( .*)? --pppd-ifname[= ]'"$IFNAME"'( |$)'

die() { echo "fortivpn: $*" >&2; exit 1; }
note() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==>\033[0m %s\n' "$*" >&2; }
# notify-send bodies may be read as markup by the notification daemon, and
# some of what lands here (a gateway's error message) is not ours to trust.
notify() {
  local body=${1//&/&amp;}
  body=${body//</&lt;}
  body=${body//>/&gt;}
  notify-send -a "$APP" -i network-vpn "$APP" "$body" 2>/dev/null || true
}

# Same message twice: to the desktop, and to the terminal when there is one.
# `up` and `down` are reached from the menu and the bar as often as from a
# shell, and a caller who typed the command should not have to watch for a
# notification to learn nothing happened.
announce() { interactive && note "$1"; notify "$1"; return 0; }

interactive() { [[ -t 0 && -t 1 ]]; }

# The connect window's banner, in the font and green of Omarchy's own logo.
show_logo() {
  interactive || return 0
  clear
  printf '\033[32m'
  cat <<'LOGO'
 ▄█████▄    ▄▄▄▄███▄▄▄▄      ▄███████    ▄████████  ▄█████▄     ▄███████     ███      ▄█   ▄█   █▄     ▄███████▄ ███▄▄▄▄
███   ███ ▄██▀▀▀███▀▀▀██▄   ███   ███   ███    ███ ███   ███   ███   ███ ▀█████████▄ ███  ███   ███   ███    ███ ███▀▀▀██▄
███   ███ ███   ███   ███   ███   ███   ███    █▀  ███   ███   ███   ███    ▀███▀▀██ ███▌ ███   ███   ███    ███ ███   ███
███   ███ ███   ███   ███   ███   ███  ▄███▄▄▄     ███   ███  ▄███▄▄▄██▀     ███   ▀ ███▌ ███   ███   ███    ███ ███   ███
███   ███ ███   ███   ███ ▀██████████ ▀▀███▀▀▀     ███   ███ ▀▀███▀▀▀▀       ███     ███▌ ███   ███ ▀█████████▀  ███   ███
███   ███ ███   ███   ███   ███   ███   ███        ███   ███ ▀██████████     ███     ███  ███   ███   ███        ███   ███
███   ███ ███   ███   ███   ███   ███   ███        ███   ███   ███   ███     ███     ███  ███   ███   ███        ███   ███
 ▀█████▀   ▀█   ███   █▀    ███   █▀    ███         ▀█████▀    ███   ███    ▄████▀   █▀    ▀█████▀   ▄████▀       ▀█   █▀
                                                               ███   ███
LOGO
  printf '\033[0m\n'
}

need() { command -v "$1" >/dev/null || die "'$1' is required but not installed"; }

# A password and a one-time token can only come from a person at a keyboard.
# gum when it is there, plain `read` when it is not; both put the prompt on
# the terminal and the answer on stdout, so either can be captured.
ask_secret() {
  local value
  if command -v gum >/dev/null; then
    gum input --password --prompt "$1 "
  else
    read -rsp "$1 " value && echo >&2 && printf '%s\n' "$value"
  fi
}

ask_plain() {
  local value
  if command -v gum >/dev/null; then
    gum input --prompt "$1 "
  else
    read -rp "$1 " value && printf '%s\n' "$value"
  fi
}

# ---------------------------------------------------------------- profiles

# Profile names become file names, so keep them to something that cannot
# escape PROFILE_DIR or confuse the shell.
valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]]; }

# 1–65535, no sign, no leading zero: what a TCP port is, and nothing a config
# parser or a shell could read as something else.
valid_port() { [[ $1 =~ ^[1-9][0-9]{0,4}$ ]] && (($1 <= 65535)); }

# One-time tokens are short alphanumerics (hyphens appear in some vendors'
# formats). Empty is allowed by the caller: push approval, or no 2FA.
valid_otp() { [[ $1 =~ ^[A-Za-z0-9-]{4,128}$ ]]; }

conf_path() { echo "$PROFILE_DIR/$1.conf"; }

# A gateway rarely arrives as a bare name: it is pasted as
# `https://vpn.example.com:10442/remote/login`, or typed with the port stuck
# to it. openfortivpn takes host and port as two separate settings and
# resolves `host` literally, so anything left attached turns into a DNS
# failure with nothing in the message to point at the real mistake. Strip the
# scheme and the path here, where it is still obvious what happened.
normalize_host() {
  local raw=$1
  raw=${raw#*://}
  raw=${raw%%/*}
  echo "$raw"
}

list_profiles() {
  find "$PROFILE_DIR" -maxdepth 1 -type f -name '*.conf' -printf '%f\n' 2>/dev/null |
    sed 's/\.conf$//' | sort
  return 0
}

default_profile() {
  local saved
  if [[ -r $DEFAULT_FILE ]]; then
    saved=$(<"$DEFAULT_FILE")
    saved=${saved//[[:space:]]/}
    [[ -n $saved && -f $(conf_path "$saved") ]] && { echo "$saved"; return 0; }
  fi
  list_profiles | head -n1
}

# Resolve an argument into a profile name: explicit name, else a gum picker
# when there is a terminal to show it in, else the default profile.
resolve_profile() {
  local name=${1:-} header=${2:-Profile:} profiles

  if [[ -n $name ]]; then
    valid_name "$name" || die "invalid profile name '$name'"
    [[ -f $(conf_path "$name") ]] || die "no profile named '$name' (try: fortivpn list)"
    echo "$name"; return 0
  fi

  profiles=$(list_profiles)
  [[ -z $profiles ]] && die "no profiles yet — create one with: fortivpn new"

  if [[ $(wc -l <<<"$profiles") -eq 1 ]] || ! interactive; then
    default_profile; return 0
  fi

  need gum
  gum choose --header "$header" <<<"$profiles"
}

# ---------------------------------------------------------------- conf files

get_key() {
  sed -nE "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*(.*[^[:space:]])[[:space:]]*\$/\1/p" "$1" | head -n1
}

# Rewrite key in place, uncommenting an existing commented-out line, or append
# it. Written back through the original inode so mode 600 survives the edit.
set_key() {
  local file=$1 key=$2 value=$3 tmp
  tmp=$(mktemp) || die "could not create a temporary file"
  if grep -qE "^[[:space:]]*#?[[:space:]]*$key[[:space:]]*=" "$file"; then
    awk -v k="$key" -v v="$value" '
      !replaced && $0 ~ "^[[:space:]]*#?[[:space:]]*" k "[[:space:]]*=" { print k " = " v; replaced = 1; next }
      { print }
    ' "$file" >"$tmp"
  else
    cat "$file" >"$tmp"
    printf '%s = %s\n' "$key" "$value" >>"$tmp"
  fi
  cat "$tmp" >"$file"
  rm -f "$tmp"
}
# `openfortivpn` can register DNS servers and search domains supplied by the
# gateway, but it cannot configure additional split-DNS routing domains. Keep
# those as comments so the file remains a valid upstream openfortivpn profile.
dns_routing_domains() {
  sed -nE 's/^[[:space:]]*#[[:space:]]*dns-routing-domain[[:space:]]*=[[:space:]]*([^[:space:]#]+).*/\1/p' "$1"
}

valid_dns_domain() {
  local domain=${1%.} label
  [[ -n $domain && ${#domain} -le 253 && $domain != .* && $domain != *. && $domain != *..* ]] || return 1
  IFS=. read -r -a labels <<<"$domain"
  for label in "${labels[@]}"; do
    [[ $label =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || return 1
  done
}

# Preserve the gateway's DNS search domains and add the profile's route-only
# domains. The latter direct only matching lookups through the VPN DNS.
sync_dns_routing_domains() {
  local conf=$1 domain current
  local -a current_domains=() domains=() route_domains=()

  command -v resolvectl >/dev/null || return 0
  mapfile -t domains < <(dns_routing_domains "$conf")
  ((${#domains[@]})) || return 0

  for domain in "${domains[@]}"; do
    domain=${domain%.}
    valid_dns_domain "$domain" || {
      warn "Ignoring invalid dns-routing-domain '$domain' in $conf"
      continue
    }
    route_domains+=("~$domain")
  done
  ((${#route_domains[@]})) || return 0

  current=$(resolvectl domain "$IFNAME" 2>/dev/null | sed -nE 's/^[^:]*:[[:space:]]*//p')
  [[ -n $current ]] && read -r -a current_domains <<<"$current"

  for domain in "${route_domains[@]}"; do
    [[ " ${current_domains[*]} " == *" $domain "* ]] || current_domains+=("$domain")
  done

  resolve_as_root domain "$IFNAME" "${current_domains[@]}" &&
    resolve_as_root flush-caches ||
    warn "Could not configure split-DNS routing domains on $IFNAME"
}

# resolved guards set-domains and flush-caches with polkit `auth_admin_keep`,
# which keeps the grant for one calling process only: run unprivileged, each
# resolvectl call is a password dialog of its own, on top of the sudo prompt
# the connect has just answered. That sudo timestamp is still fresh here, so
# spend it; polkit stays the fallback when there is no way to ask for sudo.
resolve_as_root() {
  if sudo -n true 2>/dev/null || interactive; then
    sudo resolvectl "$@"
  else
    resolvectl "$@"
  fi
}

set_dns_routing_domains() {
  local conf=$1 domain tmp
  shift
  tmp=$(mktemp) || die "could not create a temporary file"
  awk '!/^[[:space:]]*#[[:space:]]*dns-routing-domain[[:space:]]*=/' "$conf" >"$tmp"
  {
    printf '\n# Additional private DNS zones routed only through this VPN.\n'
    for domain in "$@"; do
      printf '# dns-routing-domain = %s\n' "$domain"
    done
  } >>"$tmp"
  cat "$tmp" >"$conf"
  rm -f "$tmp"
}


# ---------------------------------------------------------------- root-bound profile

# The profile is yours to edit, but what root's openfortivpn reads at connect
# time must not be. openfortivpn accepts options that make a root process load
# an arbitrary shared object (pppd-plugin), run an arbitrary pppd peer file
# (pppd-call), write to an arbitrary path (pppd-log), or hand a program
# argument to ip-up scripts (pppd-ipparam), and it reads whatever file the
# path-valued keys name. So the profile is read once, here, into memory; every
# line must be a comment or an allowlisted `key = value` whose value has the
# shape that key can legitimately take; and what is handed to root is the
# re-rendered result, never the file. Nothing unknown passes, so a key added
# to openfortivpn later stays out until it is reviewed and added here.
#
# Path-valued keys (ca-file, user-cert, user-key) are refused rather than
# copied: root would be reading a file you own, which is the very thing the
# root-owned runtime directory exists to avoid, and a client certificate is
# not part of the username + password (+ 2FA) flow this plugin supports.
#
# `password` is allowed because the profile example documents storing one for
# gateways without 2FA; `otp` is refused because a token is only ever typed at
# the prompt. pppd-ifname is ours to set. persistent would reconnect with a
# token nobody is there to type, and pinentry runs a program as root.
profile_value_ok() {
  local key=$1 value=$2
  case $key in
    host) [[ $value =~ ^[][A-Za-z0-9._:-]+$ ]] ;;
    port) valid_port "$value" ;;
    username | password) [[ -n $value ]] ;;
    trusted-cert) trusted_cert_is_valid "$value" ;;
    set-dns | use-resolvconf | set-routes | half-internet-routes | \
      pppd-use-peerdns | pppd-accept-remote | insecure-ssl | seclevel-1 | no-ftm-push)
      [[ $value =~ ^[01]$ ]] ;;
    realm) [[ $value =~ ^[A-Za-z0-9._-]+$ ]] ;;
    cipher-list) [[ $value =~ ^[A-Za-z0-9:!+@=_.,-]+$ ]] ;;
    min-tls) [[ $value =~ ^[A-Za-z0-9._]+$ ]] ;;
    *) return 1 ;;
  esac
}

# Prints the sanitized profile, one canonical `key = value` per line, or dies
# naming the first offending key and line. Call as `body=$(profile_filter F)
# || exit 1`: the message is already on stderr.
profile_filter() {
  local file=$1 line key value lineno=0 hint have_host=0
  [[ -r $file ]] || die "cannot read $file"

  while IFS= read -r line || [[ -n $line ]]; do
    ((lineno += 1))
    # Tabs are allowed, so they are dropped before testing. A bracket built
    # from raw $'\x01'… bytes does not work here: bash uses \x01 and \x7f as
    # internal quoting markers, mangles them in a regex, and every line then
    # fails with "invalid regular expression" — silently skipping this check.
    if [[ ${line//$'\t'/} == *[[:cntrl:]]* ]]; then
      die "$file:$lineno: control character in line (carriage returns included)"
    fi
    [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue

    if [[ ! $line =~ ^[[:space:]]*([A-Za-z0-9-]+)[[:space:]]*=[[:space:]]*(.*[^[:space:]])?[[:space:]]*$ ]]; then
      die "$file:$lineno: not a 'key = value' line"
    fi
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]}

    case $key in
      pppd-plugin | pppd-call | pppd-ipparam | pppd-log | pppd-ifname | pinentry)
        hint="would let a root process load, run or write something of your choosing" ;;
      ca-file | user-cert | user-key | pem-passphrase)
        hint="refers to a file you own that root would read; client certificates are not supported" ;;
      otp | cookie | persistent)
        hint="is not accepted from a profile: the token is typed at connect time and there is no reconnect" ;;
      *) hint="is not an option this plugin passes to a root process" ;;
    esac
    profile_value_ok "$key" "$value" || {
      if [[ $key =~ ^(host|port|username|password|trusted-cert|set-dns|use-resolvconf|set-routes|half-internet-routes|pppd-use-peerdns|pppd-accept-remote|insecure-ssl|seclevel-1|no-ftm-push|realm|cipher-list|min-tls)$ ]]; then
        [[ $key == trusted-cert ]] &&
          die "$file:$lineno: malformed trusted-cert; re-run: fortivpn trust $(basename "$file" .conf)"
        die "$file:$lineno: invalid value for '$key'"
      fi
      die "$file:$lineno: '$key' $hint"
    }
    [[ $key == host ]] && have_host=1
    printf '%s = %s\n' "$key" "$value"
  done <"$file"

  ((have_host)) || die "$file: no 'host' set"
}


# ---------------------------------------------------------------- state

vpn_pid() { pgrep -U 0 -f -- "$VPN_MATCH" | head -n1; }

tunnel_ip() {
  ip -4 -o addr show dev "$IFNAME" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1
}

# The live profile is read off the running process, not a state file, so the
# indicator stays correct even for a tunnel someone brought up by hand.
active_conf() {
  local pid=$1 argv i
  [[ -z $pid ]] && return 0
  mapfile -d '' -t argv <"/proc/$pid/cmdline" 2>/dev/null || return 0
  for ((i = 0; i < ${#argv[@]}; i++)); do
    case ${argv[i]} in
      -c) echo "${argv[i + 1]:-}"; return 0 ;;
      --config=*) echo "${argv[i]#--config=}"; return 0 ;;
      -c?*) echo "${argv[i]#-c}"; return 0 ;;
    esac
  done
}

active_profile() {
  local conf
  conf=$(active_conf "$1")
  [[ -n $conf ]] && basename "$conf" .conf
}

uptime_seconds() {
  local pid=$1 secs
  [[ -z $pid ]] && { echo 0; return; }
  secs=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')
  echo "${secs:-0}"
}

state() {
  if [[ -n $(tunnel_ip) ]]; then echo connected
  elif [[ -n $(vpn_pid) ]]; then echo connecting
  else echo disconnected
  fi
}

# The log of the most recent connection attempt, whichever profile it was for.
newest_log() {
  find "$LOG_DIR" -maxdepth 1 -type f -name '*.log' -printf '%T@\t%p\n' 2>/dev/null |
    sort -rn | head -n1 | cut -f2-
}

# Whether a log is of a tunnel that came up and later went away, as opposed to
# one that never got through the handshake.
log_dropped() { grep -q 'Tunnel is up and running' "$1" 2>/dev/null; }

# Why a tunnel ended, when it ended badly. For a failed handshake,
# openfortivpn's first ERROR names the cause — a rejected password, an
# unpinned certificate — and the ones after it are the teardown complaining.
# For a tunnel that dropped, that first ERROR is only the read failing on a
# link already gone; pppd's own line about the echo requests going unanswered
# is the cause worth showing. A clean `fortivpn down` logs neither.
first_error() {
  local reason=""
  [[ -f $1 ]] || return 0
  grep -q '^ERROR:' "$1" || return 0
  log_dropped "$1" && reason=$(grep -m1 -oE 'No response to [0-9]+ echo-requests' "$1")
  [[ -n $reason ]] || reason=$(sed -nE 's/^ERROR:[[:space:]]*//p' "$1" | head -n1)
  printf '%s\n' "$reason" | cut -c1-300
}

json_bool() { if "$@"; then echo true; else echo false; fi }

profiles_json() {
  local name conf def
  def=$(default_profile)
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    conf=$(conf_path "$name")
    jq -nc --arg name "$name" --arg host "$(get_key "$conf" host)" \
      --argjson default "$(json_bool [ "$name" = "$def" ])" \
      --argjson pinned "$(json_bool [ -n "$(get_key "$conf" trusted-cert)" ])" \
      '{name: $name, host: $host, default: $default, pinned: $pinned}'
  done < <(list_profiles) | jq -sc .
}

# ---------------------------------------------------------------- commands

cmd_status() {
  local st pid ip profile up log="" error="" error_at=0 error_kind=""
  pid=$(vpn_pid); ip=$(tunnel_ip); st=$(state)
  profile=$(active_profile "$pid"); up=$(uptime_seconds "$pid")
  [[ $st == disconnected ]] && { profile=""; up=0; }

  # While a tunnel is up or on its way, its log is still being written and an
  # ERROR in it is not yet the end of the story.
  if [[ $st == disconnected ]]; then
    log=$(newest_log)
    error=$(first_error "$log")
    if [[ -n $error ]]; then
      error_at=$(stat -c %Y "$log" 2>/dev/null || echo 0)
      if log_dropped "$log"; then error_kind=dropped; else error_kind=failed; fi
    fi
  fi

  if [[ ${1:-} == --json ]]; then
    need jq
    jq -nc \
      --arg state "$st" --arg profile "$profile" --arg ip "$ip" \
      --arg iface "$IFNAME" --argjson uptime "${up:-0}" \
      --arg default "$(default_profile)" --argjson profiles "$(profiles_json)" \
      --arg error "$error" --arg errorProfile "$( [[ -n $error ]] && basename "$log" .log)" \
      --argjson errorAt "${error_at:-0}" --arg errorKind "$error_kind" \
      '{state: $state, profile: $profile, ip: $ip, iface: $iface, uptime: $uptime,
        default: $default, profiles: $profiles,
        error: $error, errorKind: $errorKind, errorProfile: $errorProfile, errorAt: $errorAt}'
    return 0
  fi

  echo "state:    $st"
  [[ -n $profile ]] && echo "profile:  $profile"
  [[ -n $ip ]] && echo "address:  $ip ($IFNAME)"
  [[ ${up:-0} -gt 0 ]] && echo "uptime:   $((up / 60))m"
  [[ -n $error ]] && echo "last end: $(basename "$log" .log) — $error (log: $log)"
  return 0
}

cmd_is_up() { [[ $(state) == connected ]]; }

# Removing the transient config is the one thing that must happen on every
# path out of cmd_run, including a Ctrl+C at the password prompt. It is root's
# file, so this rides on the sudo timestamp the connect primed; the unit's
# ExecStopPost and the tmpfs it lives on are the backstops if that has lapsed.
run_cleanup() {
  [[ -n $RUN_CONF ]] && sudo -n rm -f -- "$RUN_CONF" 2>/dev/null
  RUN_CONF=""
  return 0
}

# Runs inside the floating terminal, but only for as long as the handshake
# takes. The secrets are collected here because a terminal is the only place
# to ask for them; the tunnel itself is then started in a session of its own,
# so this window can close while the connection stays up.
cmd_run() {
  local profile=$1 conf log body password="" token="" waited=0 limit=90 tail_pid=""
  conf=$(conf_path "$profile")
  [[ -f $conf ]] || die "no profile named '$profile'"
  [[ -x $OPENFORTIVPN ]] || die "'$OPENFORTIVPN' is required but not installed"

  # Validate (and snapshot) the profile before anything asks for root: a
  # rejected key should cost no sudo prompt, and what is checked here is the
  # very text that is sent to root below.
  body=$(profile_filter "$conf") || exit 1
  need systemd-run

  show_logo
  echo "Connecting to '$profile'…"
  echo "This window closes once the tunnel is up. Disconnect with: fortivpn down"
  [[ -z $(get_key "$conf" trusted-cert) ]] &&
    warn "This profile has no trusted-cert yet. If the gateway certificate is rejected, run: fortivpn trust $profile"
  echo

  # Ask for root here, while there is still a terminal to ask on. Priming the
  # sudo timestamp is what lets the launch below run without one.
  sudo -v || die "root is required to bring the tunnel up"

  # A cancelled prompt has to stop the connection, not fall through to one
  # with no password in it: with no terminal left to ask on, openfortivpn
  # would fail on the far side of a window that had already closed.
  if ! grep -q '^password = ' <<<"$body"; then
    password=$(ask_secret "VPN account password:") || die "cancelled"
    [[ -n $password ]] || die "a password is required"
  fi
  [[ $password != *$'\n'* && $password != *$'\r'* ]] || die "the password cannot contain a line break"
  token=$(ask_plain "2FA token (leave empty for push approval, or no 2FA):") || die "cancelled"
  [[ -z $token ]] || valid_otp "$token" || die "the 2FA token must be 4–128 letters, digits or hyphens"
  echo

  # openfortivpn reads the password and the one-time token from its config
  # file, and a config file is the only way to hand them to a process that has
  # no terminal to be asked on. The copy is streamed to root over a pipe and
  # written by root into a root-only directory on tmpfs, mode 600: what the
  # tunnel reads is exactly what was piped, and no path you own is ever
  # handed to it. It is deleted as soon as the handshake settles — the profile
  # itself never gains a password it did not already have.
  #
  # It is named for the profile, not for the run, because the indicator reads
  # the live profile name off the `-c` argument of the running process.
  sudo install -d -m 0700 -o root -g root "$RUN_DIR" ||
    die "could not create $RUN_DIR"
  RUN_CONF="$RUN_DIR/$profile.conf"
  trap 'run_cleanup; exit 130' INT TERM
  trap run_cleanup EXIT

  {
    printf '%s\n' "$body"
    [[ -n $password ]] && printf 'password = %s\n' "$password"
    [[ -n $token ]] && printf 'otp = %s\n' "$token"
    :
  } | sudo install -m 0600 -o root -g root /dev/stdin "$RUN_CONF" ||
    die "could not write $RUN_CONF"

  # The log is created empty by root, in a directory only root can write to,
  # before systemd opens it for appending; your group can read both.
  sudo install -d -m 0750 -o root -g "$(id -g)" "$LOG_DIR" ||
    die "could not create $LOG_DIR"
  log="$LOG_DIR/$profile.log"
  sudo install -m 0640 -o root -g "$(id -g)" /dev/null "$log" ||
    die "could not create $log"

  # Root is needed for the tunnel, but sudo must not be the thing that owns
  # it. Since 1.9.14 sudo runs its command in a pty by default (`use_pty`),
  # and when that command exits sudo tears the pty down and kills whatever is
  # left in its session — so a tunnel detached with `setsid` under sudo is
  # killed before it manages to write its first line, which looks exactly like
  # a connection that failed for no reason.
  #
  # systemd-run hands the job to PID 1 instead. sudo only asks for the unit to
  # be started and returns; the tunnel belongs to systemd and outlives both it
  # and this window. Type=exec makes that ask wait until openfortivpn has
  # actually been exec'd, so a launch that never got off the ground is an
  # error here rather than a silent failure to appear.
  #
  # --persistent is deliberately left out: a reconnect would need a fresh
  # one-time token, and by then there is nobody at a terminal to type one.
  #
  # The unit is sandboxed because the profile is only partly trusted input and
  # the process is a network-facing parser running as root. What each setting
  # costs openfortivpn/pppd, which need netlink routes, /run pid files,
  # resolvectl over the system bus and a read of /etc/ppp, and write nothing
  # under /usr, /boot or /home:
  #   ProtectHome=yes       no business in /home (profiles reach it as a pipe)
  #   PrivateTmp=yes        its own /tmp
  #   ProtectSystem=full    /usr, /boot and /etc read-only; /run and /var stay
  #                         writable. /etc/resolv.conf is re-opened writable
  #                         because a profile with use-resolvconf = 0 makes
  #                         openfortivpn edit it in place.
  #   NoNewPrivileges=yes   nothing it execs can gain more than root already is
  #   UMask=0077            files it creates are root's alone
  # Restart=no is stated rather than assumed: a restart would reuse a spent
  # one-time token, and by then the config is gone. TimeoutStartSec bounds a
  # launch that hangs; TimeoutStopSec turns a SIGINT that is ignored into
  # SIGKILL instead of a unit stuck deactivating.
  sudo systemd-run --quiet --collect --unit="$UNIT" \
    --property=Type=exec \
    --property=KillSignal=SIGINT \
    --property=Restart=no \
    --property=TimeoutStartSec=30 \
    --property=TimeoutStopSec=30 \
    --property=ProtectHome=yes \
    --property=PrivateTmp=yes \
    --property=ProtectSystem=full \
    --property=ReadWritePaths=-/etc/resolv.conf \
    --property=NoNewPrivileges=yes \
    --property=UMask=0077 \
    --property=StandardOutput=append:"$log" \
    --property=StandardError=append:"$log" \
    --property=ExecStopPost="/usr/bin/rm -f -- $RUN_CONF" \
    "$OPENFORTIVPN" -c "$RUN_CONF" --pppd-ifname="$IFNAME" ||
    die "could not start the tunnel; if a stale unit is in the way: sudo systemctl reset-failed $UNIT"

  # Show the handshake while it happens. There is nothing to watch after it,
  # and nothing left in this window that the tunnel depends on.
  tail -n +1 -f "$log" &
  tail_pid=$!

  # "No process" means two different things depending on when it is asked.
  # Before openfortivpn is visible to pgrep it means "not yet"; after it has
  # been seen once it means the tunnel died. Reading the first as the second
  # would report a failure and delete the config the process is still about to
  # read.
  local seen=0
  while ((waited < limit)); do
    cmd_is_up && break
    if [[ -n $(vpn_pid) ]]; then
      seen=1
    elif ((seen)) || ((waited >= 5)); then
      break
    fi
    sleep 1
    ((waited += 1))
  done

  [[ -n $tail_pid ]] && { kill "$tail_pid" 2>/dev/null; wait "$tail_pid" 2>/dev/null; }
  run_cleanup
  echo

  if cmd_is_up; then
    sync_dns_routing_domains "$conf"
    announce "Connected to $profile"
    return 0
  fi

  if [[ -z $(vpn_pid) ]]; then
    local reason
    reason=$(first_error "$log")
    warn "The connection failed${reason:+: $reason}"
    warn "Full log: $log"
    notify "Could not connect to $profile${reason:+: $reason}"
  else
    warn "Still negotiating after ${limit}s. Check with: fortivpn status"
    warn "The tunnel is running detached; stop it with: fortivpn down"
  fi
  interactive && read -rsn1 -p "Press any key to close… "
  return 1
}

cmd_up() {
  local profile pid
  # A second openfortivpn on the same interface would fight the first for the
  # tunnel, and the handshake window — password, then 2FA token — is wide
  # enough to click Connect twice in.
  pid=$(vpn_pid)
  if [[ -n $pid ]]; then
    if cmd_is_up; then
      announce "Already connected ($(active_profile "$pid"))"
    else
      announce "A connection is already in progress"
    fi
    return 0
  fi
  profile=$(resolve_profile "${1:-}" "Connect to:") || exit 1
  [[ -z $profile ]] && return 0
  # Not the -with-presentation launcher: it clears to the Omarchy logo first
  # and ends on a "Done" keypress, while this window is meant to close itself
  # once the tunnel is up. The app-id is what makes Omarchy float it; the gum
  # styling is exported the same way that launcher does.
  source omarchy-restart-gum 2>/dev/null || true
  setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title=Omarchy \
    -e "$SELF" _run "$profile"
}

cmd_down() {
  [[ -z $(vpn_pid) ]] && { announce "No active connection"; return 0; }

  # SIGINT is openfortivpn's clean shutdown: it tears down the routes and the
  # DNS registration before exiting. SIGKILL would leave both behind.
  #
  # The target is described, not numbered. Handing a PID we looked up earlier
  # to a privileged wrapper leaves a window in which that PID can be recycled
  # onto an unrelated process, and the signal would then be delivered to it as
  # root. pkill resolves the pattern at signal time, inside the privileged
  # call, so no such window exists.
  #
  # The pattern is narrow on purpose: only an openfortivpn started on this
  # plugin's interface is signalled, so a tunnel someone else on this machine
  # is running — or one of your own on another interface — is left alone.
  if sudo -n true 2>/dev/null; then
    sudo pkill -U 0 -INT -f -- "$VPN_MATCH"
  else
    pkexec /usr/bin/pkill -U 0 -INT -f -- "$VPN_MATCH"
  fi
}

cmd_toggle() { if cmd_is_up; then cmd_down; else cmd_up "${1:-}"; fi }

# The handshake log of a profile, or of the most recent attempt. It outlives the
# connect window, so this is where a failure that window showed can be re-read.
cmd_log() {
  local log
  if [[ -n ${1:-} ]]; then
    valid_name "$1" || die "invalid profile name '$1'"
    log="$LOG_DIR/$1.log"
  else
    log=$(newest_log)
  fi
  [[ -n $log && -f $log ]] || die "no connection log yet"

  if interactive; then
    less +G "$log"
  else
    omarchy-launch-floating-terminal-with-presentation "$(printf 'less +G %q' "$log")"
  fi
}

cmd_use() {
  local profile
  profile=$(resolve_profile "${1:-}" "Default profile:") || exit 1
  [[ -z $profile ]] && return 0
  mkdir -p "$CONFIG_DIR"
  echo "$profile" >"$DEFAULT_FILE"
  note "Default profile: $profile"
  notify "Default profile: $profile"
}

cmd_new() {
  local name="" host="" port=443 port_given=0 username="" set_routes=1
  local -a dns_domains=()

  while (($# > 0)); do
    case $1 in
      --host) host=${2:-}; shift 2 ;;
      --port) port=${2:-}; port_given=1; shift 2 ;;
      --username | --user) username=${2:-}; shift 2 ;;
      --dns-domain) dns_domains+=("${2:-}"); shift 2 ;;
      --split-tunnel) set_routes=0; shift ;;
      -*) die "unknown option for new: $1" ;;
      *) name=$1; shift ;;
    esac
  done

  if [[ -z $name ]]; then
    interactive || die "usage: fortivpn new <name> --host <gateway> --username <user>"
    need gum
    name=$(gum input --prompt "Profile name: " --placeholder work) || return 0
  fi
  [[ -n $name ]] || return 0
  valid_name "$name" || die "invalid profile name '$name' (letters, digits, . _ - only)"
  [[ -f $(conf_path "$name") ]] && die "profile '$name' already exists (edit it with: fortivpn edit $name)"

  if [[ -z $host ]]; then
    interactive || die "--host is required"
    need gum
    host=$(gum input --prompt "Gateway host: " --placeholder vpn.example.com) || return 0
  fi
  host=$(normalize_host "$host")

  # Only a single trailing `:digits` is a port. An IPv6 literal has more than
  # one colon, and cutting at the last one would quietly mangle the address.
  if [[ $host =~ ^([^:]+):([0-9]+)$ ]]; then
    if ((port_given)) && [[ $port != "${BASH_REMATCH[2]}" ]]; then
      die "gateway host carries port ${BASH_REMATCH[2]} but --port says $port"
    fi
    host=${BASH_REMATCH[1]}
    port=${BASH_REMATCH[2]}
  fi
  [[ -n $host ]] || die "gateway host is required"

  if [[ -z $username ]]; then
    interactive || die "--username is required"
    username=$(gum input --prompt "Username: " --value "$USER") || return 0
  fi
  [[ -n $username ]] || die "username is required"

  valid_port "$port" || die "port must be a number from 1 to 65535"

  for domain in "${dns_domains[@]}"; do
    domain=${domain%.}
    valid_dns_domain "$domain" || die "invalid DNS routing domain '$domain'"
  done

  if interactive && command -v gum >/dev/null; then
    gum confirm "Route all traffic through the VPN (full tunnel)?" && set_routes=1 || set_routes=0
  fi

  mkdir -p "$PROFILE_DIR"
  chmod 700 "$CONFIG_DIR" "$PROFILE_DIR"

  local conf
  conf=$(conf_path "$name")
  (umask 077; write_profile "$conf" "$host" "$port" "$username" "$set_routes" "${dns_domains[@]}")
  chmod 600 "$conf"
  note "Created $conf"

  [[ -z $(default_profile) || $(list_profiles | wc -l) -eq 1 ]] && echo "$name" >"$DEFAULT_FILE"

  if interactive && command -v gum >/dev/null &&
    gum confirm "Fetch and pin the gateway's certificate fingerprint now?"; then
    cmd_trust "$name"
  else
    note "Pin the certificate later with: fortivpn trust $name"
  fi
}

write_profile() {
  local conf=$1 host=$2 port=$3 username=$4 set_routes=$5 domain
  shift 5
  cat >"$conf" <<CONF
# openfortivpn profile '$(basename "$conf" .conf)'.
# Managed by the Omarchy FortiVPN plugin — see \`fortivpn help\`.

### Gateway ###################################################################

host = $host
port = $port

### Credentials ###############################################################

username = $username

# The password is deliberately absent. With 2FA it is useless on its own, and
# openfortivpn asks for the password and the token in the terminal at connect
# time. If your gateway has no 2FA and you want it stored, uncomment the line
# below — it is plain text, so keep this file at mode 600.
# password = ...

### Gateway certificate #######################################################

# Filled in by \`fortivpn trust\`. Until it is set, the first connection will
# be rejected and openfortivpn will print the digest to pin.
# trusted-cert = ...

### DNS and routes ############################################################

# With use-resolvconf the VPN's DNS servers are registered against the
# $IFNAME interface (real split-DNS) instead of overwriting
# /etc/resolv.conf system-wide. On systemd-resolved hosts /usr/bin/resolvconf
# is the resolvectl shim, so this is the right setting there too.
set-dns = 1
use-resolvconf = 1

# pppd can rewrite resolv.conf as well and races openfortivpn for it. Leaving
# it off keeps the two from fighting.
pppd-use-peerdns = 0
CONF
  if (($#)); then
    cat >>"$conf" <<'CONF'

# Additional private DNS zones routed only through this VPN.
CONF
    for domain in "$@"; do
      printf '# dns-routing-domain = %s\n' "${domain%.}" >>"$conf"
    done
  fi
  cat >>"$conf" <<CONF

# 1 sends all traffic through the tunnel (full tunnel). Use 0 when the gateway
# already pushes the split-tunnel routes you need.
set-routes = $set_routes
CONF
}

cmd_edit() {
  local profile conf editor
  profile=$(resolve_profile "${1:-}" "Edit profile:") || exit 1
  [[ -z $profile ]] && return 0
  conf=$(conf_path "$profile")

  # $EDITOR is a command line, not a path: Omarchy sets it to
  # "omarchy-launch-editor --inline", so split it into words.
  read -ra editor <<<"${EDITOR:-nvim}"
  ((${#editor[@]})) || editor=(nvim)

  if interactive; then
    "${editor[@]}" "$conf"
  else
    omarchy-launch-floating-terminal-with-presentation "$(printf '%q ' "${editor[@]}" "$conf")"
  fi
}
cmd_dns() {
  local profile conf domain
  (($# >= 2)) || die "usage: fortivpn dns <profile> <domain> [domain...]"
  profile=$(resolve_profile "$1") || exit 1
  shift
  conf=$(conf_path "$profile")

  for domain in "$@"; do
    domain=${domain%.}
    valid_dns_domain "$domain" || die "invalid DNS routing domain '$domain'"
  done

  set_dns_routing_domains "$conf" "$@"
  if cmd_is_up && [[ $profile == $(active_profile "$(vpn_pid)") ]]; then
    sync_dns_routing_domains "$conf"
  fi
  note "Configured split-DNS domains for '$profile': $*"
}


cmd_delete() {
  local profile conf assume_yes=0 args=()

  for arg in "$@"; do
    case $arg in
      --yes | -y) assume_yes=1 ;;
      *) args+=("$arg") ;;
    esac
  done

  profile=$(resolve_profile "${args[0]:-}" "Delete profile:") || exit 1
  [[ -z $profile ]] && return 0
  conf=$(conf_path "$profile")

  [[ $profile == $(active_profile "$(vpn_pid)") ]] &&
    warn "'$profile' is the profile currently connected; the tunnel stays up until you disconnect"

  if ((!assume_yes)); then
    interactive || die "refusing to delete without confirmation; pass --yes"
    need gum
    gum confirm "Delete profile '$profile'? This cannot be undone." || return 0
  fi

  rm -f "$conf"
  note "Deleted $conf"

  # A default pointing at a profile that no longer exists would silently
  # resolve to some other gateway, so retire it with the file.
  [[ -r $DEFAULT_FILE && $(<"$DEFAULT_FILE") == "$profile" ]] && rm -f "$DEFAULT_FILE"
  notify "Deleted profile '$profile'"
  return 0
}

cmd_rename() {
  local old new
  old=$(resolve_profile "${1:-}" "Rename profile:") || exit 1
  [[ -z $old ]] && return 0

  new=${2:-}
  if [[ -z $new ]]; then
    interactive || die "usage: fortivpn rename <old> <new>"
    need gum
    new=$(gum input --prompt "New name: " --value "$old") || return 0
  fi
  [[ -n $new && $new != "$old" ]] || return 0
  valid_name "$new" || die "invalid profile name '$new'"
  [[ -f $(conf_path "$new") ]] && die "profile '$new' already exists"

  mv "$(conf_path "$old")" "$(conf_path "$new")"
  note "Renamed '$old' to '$new'"
  [[ -r $DEFAULT_FILE && $(<"$DEFAULT_FILE") == "$old" ]] && echo "$new" >"$DEFAULT_FILE"
  return 0
}

# Pin the gateway's certificate. openfortivpn compares trusted-cert against the
# SHA256 of the peer's DER-encoded certificate, which is exactly what this
# computes — so pinning here is the same check, done before the first connect
# instead of after a failed one.
#
# Pinning whatever the gateway presents is trust-on-first-use: anyone on the
# path at that moment gets pinned forever. So the chain the server sends is
# checked first. A leaf that chains to the system trust store, for this
# hostname, is pinned on that evidence. Anything else (a self-signed FortiGate
# is the usual case) is only pinned after the person has compared the
# fingerprint with the gateway's admin out-of-band and said so explicitly.

# Succeeds when $1 (the leaf) chains to the system trust store through the
# intermediates in $2, and is valid for $3. A bare IP is matched against the
# certificate's IP SANs rather than its DNS names.
chain_verifies() {
  local leaf=$1 chain=$2 host=$3 flag=-verify_hostname
  [[ $host =~ ^[0-9.]+$ || $host == *:* ]] && flag=-verify_ip
  openssl verify -purpose sslserver -untrusted "$chain" "$flag" "$host" "$leaf" >/dev/null 2>&1
}

# trusted-cert is hand-editable, and openfortivpn will take whatever is there.
# Anything but a SHA256 hex digest can never match a certificate, so say so
# rather than let the connect fail with an unexplained certificate error.
trusted_cert_is_valid() { [[ $1 =~ ^[0-9a-f]{64}$ ]]; }

cmd_trust() {
  local profile="" conf host port digest accept_unverified=0 arg
  for arg in "$@"; do
    case $arg in
      --accept-unverified) accept_unverified=1 ;;
      -*) die "unknown option '$arg' (usage: fortivpn trust [profile] [--accept-unverified])" ;;
      *) [[ -z $profile ]] || die "usage: fortivpn trust [profile] [--accept-unverified]"; profile=$arg ;;
    esac
  done

  profile=$(resolve_profile "$profile" "Pin certificate for:") || exit 1
  [[ -z $profile ]] && return 0
  conf=$(conf_path "$profile")

  need openssl
  host=$(get_key "$conf" host)
  port=$(get_key "$conf" port); port=${port:-443}
  [[ -n $host ]] || die "profile '$profile' has no host set"

  local current
  current=$(get_key "$conf" trusted-cert)
  if [[ -n $current ]] && ! trusted_cert_is_valid "$current"; then
    warn "trusted-cert in $conf is not a SHA256 hex digest (64 characters, 0-9 a-f), so it can never match; it will be replaced if you pin below"
  fi

  note "Fetching the certificate chain from $host:$port"

  # The chain goes to files rather than down a pipe into a hash: a gateway
  # that is unreachable, or that hangs up mid-handshake, yields no bytes at
  # all, and hashing nothing produces a perfectly well-formed digest of the
  # empty string. Pinning that would overwrite a working trusted-cert with a
  # value no certificate can ever match.
  #
  # timeout, because a gateway that accepts the connection and then says
  # nothing would otherwise leave s_client waiting for a handshake that never
  # finishes, in a terminal with no hint of why.
  local work leaf chain
  work=$(mktemp -d) || die "could not create a temporary directory"
  leaf=$work/leaf.pem chain=$work/chain.pem

  timeout 15 openssl s_client -connect "$host:$port" -servername "$host" -showcerts \
    </dev/null 2>/dev/null >"$work/showcerts.txt"

  # showcerts prints the leaf first, then whatever intermediates were sent.
  awk -v dir="$work" '
    /-----BEGIN CERTIFICATE-----/ { n++; out = sprintf("%s/cert-%d.pem", dir, n) }
    out != "" { print > out }
    /-----END CERTIFICATE-----/ { close(out); out = "" }
  ' "$work/showcerts.txt"

  if [[ ! -s $work/cert-1.pem ]] || ! openssl x509 -in "$work/cert-1.pem" -noout 2>/dev/null; then
    rm -rf "$work"
    die "could not read a certificate from $host:$port"
  fi
  cp "$work/cert-1.pem" "$leaf"
  cat "$work"/cert-*.pem >"$chain"

  digest=$(openssl x509 -in "$leaf" -outform DER 2>/dev/null | sha256sum | awk '{print $1}')
  if ! [[ $digest =~ ^[0-9a-f]{64}$ ]] || [[ $digest == e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 ]]; then
    rm -rf "$work"
    die "could not read a certificate from $host:$port"
  fi

  if chain_verifies "$leaf" "$chain" "$host"; then
    note "Certificate chain verified against the system trust store, and it is valid for $host"
  else
    local subject issuer starts ends fingerprint
    subject=$(openssl x509 -in "$leaf" -noout -subject | sed 's/^subject= *//')
    issuer=$(openssl x509 -in "$leaf" -noout -issuer | sed 's/^issuer= *//')
    starts=$(openssl x509 -in "$leaf" -noout -startdate | cut -d= -f2)
    ends=$(openssl x509 -in "$leaf" -noout -enddate | cut -d= -f2)
    fingerprint=$(openssl x509 -in "$leaf" -noout -fingerprint -sha256 | cut -d= -f2)
    rm -rf "$work"

    warn "This certificate could NOT be verified: it does not chain to a trusted authority for $host (self-signed gateways look like this)."
    {
      echo "  Subject:     $subject"
      echo "  Issuer:      $issuer"
      echo "  Valid from:  $starts"
      echo "  Valid until: $ends"
      echo "  SHA256:      $fingerprint"
      echo
      echo "  Compare the SHA256 above with the one your VPN administrator gives you,"
      echo "  over a channel other than this connection. If it differs, someone may be"
      echo "  intercepting the connection: do not pin it."
    } >&2

    if ((accept_unverified)); then
      warn "--accept-unverified given: pinning without verification"
    elif interactive; then
      echo >&2
      if command -v gum >/dev/null; then
        gum confirm "Does this fingerprint match the one from your administrator? Pin it?" || die "not pinned"
      else
        local reply
        read -r -p "Does this fingerprint match the one from your administrator? Pin it? [y/N] " reply
        [[ $reply =~ ^[Yy]([Ee][Ss])?$ ]] || die "not pinned"
      fi
    else
      die "refusing to pin an unverified certificate without a terminal; verify the fingerprint, then re-run with --accept-unverified"
    fi
  fi
  rm -rf "$work"

  trusted_cert_is_valid "$digest" || die "internal error: malformed digest '$digest'"
  set_key "$conf" trusted-cert "$digest"
  note "Pinned trusted-cert = $digest"
}

cmd_help() {
  cat <<'USAGE'
fortivpn — FortiGate SSL VPN control for Omarchy

Connection
  fortivpn up [profile]        Connect: type password + 2FA token, window closes
  fortivpn down                Disconnect, tearing down routes and DNS cleanly
  fortivpn toggle [profile]    Connect when down, disconnect when up
  fortivpn status [--json]     Profile, tunnel address, uptime
  fortivpn is-up               Exit 0 while the tunnel is up
  fortivpn log [profile]       Read the handshake log of the last attempt

The handshake is logged to ~/.local/state/fortivpn/<profile>.log.

Profiles  (~/.config/fortivpn/profiles/<name>.conf, mode 600)
  fortivpn list                List profiles
  fortivpn new [name] [opts]   Create a profile  (--host --port --username --dns-domain --split-tunnel)
  fortivpn edit [profile]      Open a profile in $EDITOR
  fortivpn dns <profile> <domain...>
                               Route private DNS zones through this VPN
  fortivpn delete [profile]    Delete a profile  (--yes to skip the prompt)
  fortivpn rename <old> [new]  Rename a profile
  fortivpn use [profile]       Set the default profile
  fortivpn trust [profile]     Verify and pin the gateway's certificate  (--accept-unverified
                               to pin a self-signed one without a prompt)

Omitting [profile] opens a picker in a terminal, and uses the default profile
elsewhere.
USAGE
}

# ---------------------------------------------------------------- dispatch

# Sourced (by the tests), the functions are defined and nothing else happens.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

SELF=$(readlink -f "${BASH_SOURCE[0]}")

case "${1:-status}" in
  status) shift; cmd_status "$@" ;;
  log) shift; cmd_log "$@" ;;
  is-up) cmd_is_up ;;
  up | connect) shift; cmd_up "$@" ;;
  down | disconnect) cmd_down ;;
  toggle) shift; cmd_toggle "$@" ;;
  list | profiles) list_profiles ;;
  use) shift; cmd_use "$@" ;;
  new | create | add) shift; cmd_new "$@" ;;
  edit) shift; cmd_edit "$@" ;;
  dns) shift; cmd_dns "$@" ;;
  delete | remove | rm) shift; cmd_delete "$@" ;;
  rename | mv) shift; cmd_rename "$@" ;;
  trust) shift; cmd_trust "$@" ;;
  help | --help | -h) cmd_help ;;
  _run) shift; cmd_run "$@" ;;
  *) die "unknown command '$1' (try: fortivpn help)" ;;
esac
